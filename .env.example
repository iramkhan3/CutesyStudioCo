# ============================================================================
# CutesyStudioCo — environment variables
# Copy this file to .env.local for local development.
# In Vercel: Project Settings → Environment Variables (paste each one there).
# NEVER commit .env or .env.local — they're already in .gitignore.
# ============================================================================

# --- Supabase (Postgres DB) ---------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon/public key — safe to expose to the browser (not currently used client-side,
# reserved for future client-side reads if you add them).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER-SIDE ONLY. Grants full DB access. Never prefix with
# NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (payments) -------------------------------------------------
# Get these from: Razorpay Dashboard → Settings → API Keys
# Public key ID — safe to expose to the browser, used to open the checkout modal.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Secret key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never expose to the browser.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# --- Resend (order confirmation emails) — OPTIONAL ------------------------
# If unset, order confirmation emails are simply skipped (logged to server console
# instead). Get a key from: https://resend.com/api-keys
RESEND_API_KEY=
# Must be a domain you've verified in Resend, or their sandbox sender for testing.
RESEND_FROM_EMAIL="CutesyStudioCo <orders@cutesystudioco.com>"

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://cutesystudioco.com
