# ============================================================================
# CutesyStudioCo — environment variables
# Copy this file to .env.local for local development.
# In Vercel: Project Settings → Environment Variables (paste each one there).
# NEVER commit .env or .env.local — they're already in .gitignore.
# ============================================================================

# --- Supabase (Postgres DB) ---------------------------------------------
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon/public key — safe to expose to the browser (not currently used client-side,
# reserved for future client-side reads if you add them).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — SERVER-SIDE ONLY. Grants full DB access. Never prefix with
# NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Razorpay (payments — Indian buyers: Card / UPI / Netbanking) --------
# Get these from: Razorpay Dashboard → Settings → API Keys
# Public key ID — safe to expose to the browser, used to open the checkout modal.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Secret key — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never expose to the browser.
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook secret — set when adding the webhook URL in Razorpay Dashboard →
# Settings → Webhooks (subscribe to the "payment.captured" event). This is a
# backstop for app/api/verify-payment: if the customer's browser never
# completes that round trip (closed tab, network drop, function timeout),
# Razorpay still POSTs here so the order gets marked paid and its emails sent.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# --- PayPal (payments — international buyers) -----------------------------
# Get these from: https://developer.paypal.com/dashboard/applications → your
# app (sandbox and live apps have separate credential pairs).
# Public client ID — safe to expose to the browser, loads the PayPal JS SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# Secret — SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never expose to the browser.
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# "sandbox" (default/safe) or "live". Only set to "live" once you're ready to
# take real PayPal payments with live credentials above.
PAYPAL_ENVIRONMENT=sandbox

# --- Resend (order confirmation emails) — OPTIONAL ------------------------
# If unset, order confirmation emails are simply skipped (logged to server console
# instead). Get a key from: https://resend.com/api-keys
RESEND_API_KEY=
# Must be a domain you've verified in Resend, or their sandbox sender for testing.
RESEND_FROM_EMAIL="CutesyStudioCo <orders@cutesystudioco.com>"

# --- Admin dashboard (/admin) ----------------------------------------------
# Password-protects /admin (order management). Both values are SERVER-SIDE
# ONLY — never prefix with NEXT_PUBLIC_. Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If either is unset, /admin login is disabled (fails closed, not open).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://cutesystudioco.com
